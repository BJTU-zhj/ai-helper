<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/>
    </parent>

    <groupId>com.zhj.learn</groupId>
    <artifactId>ai-helper</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ai-helper</name>
    <description>AI helper microservices parent project</description>

    <modules>
        <module>ai-utility-agent-service</module>
        <module>ai-kitchen-brain-service</module>
        <module>ai-gateway</module>
        <module>ai-common</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <langchain4j.version>1.13.0</langchain4j.version>
        <langchain4j.beta.version>1.13.0-beta23</langchain4j.beta.version>
        <spring-ai.version>1.1.4</spring-ai.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <mybatis.boot.version>3.0.4</mybatis.boot.version>
        <mybatis.generator.version>1.4.2</mybatis.generator.version>
        <mysql.driver.version>8.4.0</mysql.driver.version>
        <springdoc.version>2.8.16</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              统一管理 Spring AI 生态依赖版本，子模块只声明 spring-ai-* 依赖即可，
              避免在每个服务里手动写版本号并减少版本冲突风险。
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
              统一管理 Spring Cloud 依赖版本，主要给网关模块使用（如 Spring Cloud Gateway），
              确保与当前 Spring Boot 版本的兼容性。
            -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
              统一管理 Hutool 依赖版本，子模块只声明 hutool-* 依赖即可，
              避免在每个服务里手动写版本号并减少版本冲突风险。
            -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>5.8.38</version>
            </dependency>

            <!--
              统一管理 Knife4j 依赖版本，子模块只声明 knife4j-* 依赖即可，
              避免在每个服务里手动写版本号并减少版本冲突风险。
            -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>4.4.0</version>
            </dependency>

            <!--
              统一管理 SpringDoc 版本，解决 Spring Boot 3.5.x 下与旧版 springdoc 的兼容问题。
            -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!--
              统一管理 Spring Boot 依赖版本，子模块只声明 spring-boot-* 依赖即可，
              避免在每个服务里手动写版本号并减少版本冲突风险。
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-aop</artifactId>
                <version>3.2.5</version>
            </dependency>

            <!--
              统一管理 FastJSON 依赖版本，子模块只声明 fastjson 依赖即可，
              避免在每个服务里手动写版本号并减少版本冲突风险。
            -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>fastjson</artifactId>
                <version>1.2.83</version>
            </dependency>


            <!--
              统一管理 MyBatis 依赖版本，子模块只声明 mybatis-spring-boot-starter 依赖即可，
              避免在每个服务里手动写版本号并减少版本冲突风险。
            -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis.boot.version}</version>
            </dependency>


            <!--
              统一管理 MySQL 驱动版本，子模块只声明 mysql-connector-j 依赖即可，
              避免在每个服务里手动写版本号并减少版本冲突风险。
            -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.driver.version}</version>
            </dependency>


        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.mybatis.generator</groupId>
                    <artifactId>mybatis-generator-maven-plugin</artifactId>
                    <version>${mybatis.generator.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
