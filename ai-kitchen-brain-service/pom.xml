<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zhj.learn</groupId>
        <artifactId>ai-helper</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ai-kitchen-brain-service</artifactId>
    <name>ai-kitchen-brain-service</name>
    <description>General purpose agent host service based on Spring AI</description>

    <dependencies>
        <!--
          提供基础 Web 接口能力（REST API、参数绑定、JSON 编解码），
          作为 ai-super-host 暴露通用 Agent 能力的 HTTP 入口。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          提供生产可观测与运维端点（/actuator/health、/actuator/info 等），
          便于后续接入网关健康检查、容器探针和监控系统。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          引入公共模块，便于后续复用统一 DTO、错误模型、工具类等跨服务代码。
        -->
        <dependency>
            <groupId>com.zhj.learn</groupId>
            <artifactId>ai-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          Spring AI 的 OpenAI 模型 Starter，
          负责自动装配 ChatClient / 模型调用相关 Bean，作为该服务实现通用 Agent 的基础框架依赖。
          说明：即使后续切换模型供应商，也建议保留 Spring AI 编程模型不变，仅替换对应 starter。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
          测试依赖集合，支持 Spring Boot 上下文加载测试与接口测试，
          scope=test 确保不会打入运行时产物。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          MyBatis 集成，用于数据库访问，
          scope=runtime 确保不会打入运行时产物。
        -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>

        <!--
          MySQL 8.x 驱动，用于数据库访问，
          scope=runtime 确保不会打入运行时产物。
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Knife4j 集成，提供接口文档能力，
          基于 Spring Boot 3.x 集成，支持 Jakarta EE 9.x。
        -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>


            <plugin>
                <groupId>org.mybatis.generator</groupId>
                <artifactId>mybatis-generator-maven-plugin</artifactId>
                <configuration>
                    <configurationFile>${project.basedir}/src/main/resources/generator/generatorConfig.xml</configurationFile>
                    <overwrite>true</overwrite>
                    <verbose>true</verbose>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.mysql</groupId>
                        <artifactId>mysql-connector-j</artifactId>
                        <version>${mysql.driver.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
